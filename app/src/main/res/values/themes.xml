<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Tyomatka" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Sama tausta ja kuvake kaikilla tuetuilla Android-versioilla ja teemoilla. -->
    <style name="Theme.Tyomatka.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FF0F3270</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Tyomatka</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
